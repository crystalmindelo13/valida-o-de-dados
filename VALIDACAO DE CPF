def validar_cpf(cpf):

    cpf = ''.join(filter(str.isdigit, cpf))


    if len(cpf) != 11:
        return False


    if cpf == cpf[0] * 11:
        return False


    total = sum(int(cpf[i]) * (10 - i) for i in range(9))
    digit1 = 11 - (total % 11)
    if digit1 >= 10:
        digit1 = 0


    total = sum(int(cpf[i]) * (11 - i) for i in range(10))
    digit2 = 11 - (total % 11)
    if digit2 >= 10:
        digit2 = 0


    if int(cpf[9]) == digit1 and int(cpf[10]) == digit2:
        return True
    else:
        return False

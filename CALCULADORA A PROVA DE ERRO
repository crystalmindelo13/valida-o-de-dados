import tkinter as tk


def dividir():
    try:
        dividendo = float(entrada_dividendo.get())
        divisor = float(entrada_divisor.get())

        resultado = dividendo / divisor
        lbl_resultado.config(
            text=f"Resultado: {resultado}",
            fg="green"
        )

    except ValueError:
        lbl_resultado.config(
            text="Erro: Digite apenas números válidos.",
            fg="red"
        )

    except ZeroDivisionError:
        lbl_resultado.config(
            text="Erro: Não é possível dividir por zero.",
            fg="red"
        )

    except Exception as erro:
        lbl_resultado.config(
            text=f"Erro inesperado: {erro}",
            fg="red"
        )


janela = tk.Tk()
janela.title("Calculadora à Prova de Erro")
janela.geometry("350x220")


titulo = tk.Label(janela, text="Calculadora de Divisão", font=("Arial", 14, "bold"))
titulo.pack(pady=10)


tk.Label(janela, text="Dividendo:").pack()
entrada_dividendo = tk.Entry(janela)
entrada_dividendo.pack(pady=5)


tk.Label(janela, text="Divisor:").pack()
entrada_divisor = tk.Entry(janela)
entrada_divisor.pack(pady=5)


btn_dividir = tk.Button(janela, text="Dividir", command=dividir)
btn_dividir.pack(pady=10)


lbl_resultado = tk.Label(janela, text="", font=("Arial", 11))
lbl_resultado.pack(pady=10)


janela.mainloop()
